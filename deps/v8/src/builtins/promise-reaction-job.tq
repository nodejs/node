#include 'src/builtins/builtins-promise-gen.h'

namespace promise {

transitioning macro RejectPromiseReactionJob(
    context: Context,
    promiseOrCapability: JSPromise|PromiseCapability|Undefined, reason: JSAny,
    reactionType: constexpr PromiseReactionType): JSAny {
  if constexpr (reactionType == kPromiseReactionReject) {
    typeswitch (promiseOrCapability) {
      case (promise: JSPromise): {
        // For fast native promises we can skip the indirection via the
        // promiseCapability.[[Reject]] function and run the resolve logic
        // directly from here.
        return RejectPromise(promise, reason, False);
      }
      case (Undefined): {
        return Undefined;
      }
      case (capability: PromiseCapability): {
        // In the general case we need to call the (user provided)
        // promiseCapability.[[Reject]] function.
        const reject = UnsafeCast<Callable>(capability.reject);
        return Call(context, reject, Undefined, reason);
      }
    }
  } else {
    static_assert(reactionType == kPromiseReactionFulfill);
    // We have to call out to the dedicated PromiseRejectReactionJob
    // builtin here, instead of just doing the work inline, as otherwise
    // the catch predictions in the debugger will be wrong, which just
    // walks the stack and checks for certain builtins.
    return PromiseRejectReactionJob(reason, Undefined, promiseOrCapability);
  }
}

transitioning macro FuflfillPromiseReactionJob(
    context: Context,
    promiseOrCapability: JSPromise|PromiseCapability|Undefined, result: JSAny,
    reactionType: constexpr PromiseReactionType): JSAny {
  typeswitch (promiseOrCapability) {
    case (promise: JSPromise): {
      // For fast native promises we can skip the indirection via the
      // promiseCapability.[[Resolve]] function and run the resolve logic
      // directly from here.
      return ResolvePromise(context, promise, result);
    }
    case (Undefined): {
      return Undefined;
    }
    case (capability: PromiseCapability): {
      // In the general case we need to call the (user provided)
      // promiseCapability.[[Resolve]] function.
      const resolve = UnsafeCast<Callable>(capability.resolve);
      try {
        return Call(context, resolve, Undefined, result);
      } catch (e, _message) {
        return RejectPromiseReactionJob(
            context, promiseOrCapability, e, reactionType);
      }
    }
  }
}

// https://tc39.es/ecma262/#sec-promisereactionjob
extern builtin ResumeGeneratorTrampoline(Context, JSAny, JSGeneratorObject):
    JSAny;
extern builtin AsyncGeneratorResumeNext(Context, JSAsyncGeneratorObject): JSAny;
extern builtin AsyncGeneratorReject(Context, JSAsyncGeneratorObject, JSAny):
    JSAny;
extern builtin AsyncFunctionReject(Context, JSAsyncFunctionObject, JSAny):
    JSAny;

transitioning macro ResumeGenerator(
    implicit context: Context)(generator: JSGeneratorObject, argument: JSAny,
    reactionType: constexpr PromiseReactionType): void {
  if constexpr (reactionType == kPromiseReactionFulfill) {
    generator.resume_mode = SmiConstant(kGeneratorResumeModeNext);
  } else {
    static_assert(reactionType == kPromiseReactionReject);
    generator.resume_mode = SmiConstant(kGeneratorResumeModeThrow);
  }
  if (Is<JSAsyncGeneratorObject>(generator)) {
    const asyncGen = %RawDownCast<JSAsyncGeneratorObject>(generator);
    asyncGen.is_awaiting = SmiConstant(0);
  }
  try {
    ResumeGeneratorTrampoline(context, argument, generator);
  } catch (e, _message) {
    // The generator body itself is wrapped in a try-catch, so only a
    // StackOverflow thrown in ResumeGeneratorTrampoline, the callee entry
    // prologue, or an OSR entry prologue (which precedes exception handler
    // setup) can reach this handler.
    dcheck(generator.continuation != SmiConstant(kGeneratorClosed));
    generator.continuation = SmiConstant(kGeneratorClosed);
    typeswitch (generator) {
      case (asyncGen: JSAsyncGeneratorObject): {
        AsyncGeneratorReject(context, asyncGen, e);
      }
      case (asyncFun: JSAsyncFunctionObject): {
        AsyncFunctionReject(context, asyncFun, e);
      }
      case (JSGeneratorObject): {
        unreachable;
      }
    }
  }
  if (Is<JSAsyncGeneratorObject>(generator)) {
    const asyncGen = %RawDownCast<JSAsyncGeneratorObject>(generator);
    AsyncGeneratorResumeNext(context, asyncGen);
  }
}

// https://tc39.es/ecma262/#sec-promisereactionjob
transitioning macro PromiseReactionJob(
    context: Context, argument: JSAny,
    handler: Callable|JSGeneratorObject|Undefined,
    promiseOrCapability: JSPromise|PromiseCapability|Undefined,
    reactionType: constexpr PromiseReactionType): JSAny {
  typeswitch (handler) {
    case (generator: JSGeneratorObject): {
      ResumeGenerator(generator, argument, reactionType);
      return Undefined;
    }
    case (Undefined): {
      if constexpr (reactionType == kPromiseReactionFulfill) {
        return FuflfillPromiseReactionJob(
            context, promiseOrCapability, argument, reactionType);
      } else {
        static_assert(reactionType == kPromiseReactionReject);
        return RejectPromiseReactionJob(
            context, promiseOrCapability, argument, reactionType);
      }
    }
    case (otherHandler: Callable): {
      try {
        const result = Call(context, otherHandler, Undefined, argument);
        if (promiseOrCapability == Undefined) {
          // There's no [[Capability]] for this promise reaction job, which
          // means that this is a specification-internal operation (aka
          // await) where the result does not matter (see the specification
          // change in https://github.com/tc39/ecma262/pull/1146 for
          // details).
          return Undefined;
        } else {
          return FuflfillPromiseReactionJob(
              context, promiseOrCapability, result, reactionType);
        }
      } catch (e, _message) {
        return RejectPromiseReactionJob(
            context, promiseOrCapability, e, reactionType);
      }
    }
  }
}

@export
transitioning macro PromiseFulfillReactionJobInline(
    implicit context: Context)(value: JSAny, handler: JSAny,
    promiseOrCapability: HeapObject): void labels Slow {
  if (handler == Undefined) {
    typeswitch (promiseOrCapability) {
      case (promise: JSPromise): {
        ResolvePromise(promise, value);
      }
      case (HeapObject): {
        goto Slow;
      }
    }
  } else if (promiseOrCapability == Undefined) {
    typeswitch (handler) {
      case (generator: JSGeneratorObject): {
        ResumeGenerator(generator, value, kPromiseReactionFulfill);
      }
      case (callable: Callable): {
        try {
          Call(context, callable, Undefined, value);
        } catch (e, _message) {
          PromiseRejectReactionJob(e, Undefined, Undefined);
        }
      }
      case (JSAny): {
        goto Slow;
      }
    }
  } else {
    goto Slow;
  }
}

@export
transitioning macro PromiseRejectReactionJobInline(
    implicit context: Context)(reason: JSAny, handler: JSAny,
    promiseOrCapability: HeapObject): void labels Slow {
  if (handler == Undefined) {
    typeswitch (promiseOrCapability) {
      case (promise: JSPromise): {
        RejectPromise(promise, reason, False);
      }
      case (HeapObject): {
        goto Slow;
      }
    }
  } else if (promiseOrCapability == Undefined) {
    typeswitch (handler) {
      case (generator: JSGeneratorObject): {
        ResumeGenerator(generator, reason, kPromiseReactionReject);
      }
      case (callable: Callable): {
        try {
          Call(context, callable, Undefined, reason);
        } catch (e, _message) {
          PromiseRejectReactionJob(e, Undefined, Undefined);
        }
      }
      case (JSAny): {
        goto Slow;
      }
    }
  } else {
    goto Slow;
  }
}

transitioning builtin PromiseFulfillReactionJob(
    implicit context: Context)(value: JSAny,
    handler: Callable|JSGeneratorObject|Undefined,
    promiseOrCapability: JSPromise|PromiseCapability|Undefined): JSAny {
  return PromiseReactionJob(
      context, value, handler, promiseOrCapability, kPromiseReactionFulfill);
}

transitioning builtin PromiseRejectReactionJob(
    implicit context: Context)(reason: JSAny,
    handler: Callable|JSGeneratorObject|Undefined,
    promiseOrCapability: JSPromise|PromiseCapability|Undefined): JSAny {
  return PromiseReactionJob(
      context, reason, handler, promiseOrCapability, kPromiseReactionReject);
}
}
