@cppScope('JSPromise::Flags')
bitfield struct JSPromiseFlags extends uint31 {
  status: PromisePromiseState: 2 bit;
  is_native_resolver_invoked: bool: 1 bit;
  has_handler: bool: 1 bit;
  is_silent: bool: 1 bit;
  async_task_id: uint32: 26 bit;
}

@cppObjectLayoutDefinition
extern class JSPromise extends JSObjectWithEmbedderSlots {
  macro Status(): PromisePromiseState {
    return this.flags.status;
  }

  macro SetStatus(status: constexpr PromisePromiseState): void {
    dcheck(this.Status() == PromisePromiseState::kPending);
    dcheck(status != PromisePromiseState::kPending);

    this.flags.status = status;
  }

  macro HasHandler(): bool {
    return this.flags.has_handler;
  }

  macro SetHasHandler(): void {
    this.flags.has_handler = true;
  }

  // Smi 0 terminated list of PromiseReaction objects in case the JSPromise was
  // not settled yet, otherwise the result.
  reactions_or_result: PromiseReaction|JSAny;
  flags: SmiTagged<JSPromiseFlags>;
}

@doNotGenerateCast
extern class JSPromiseConstructor extends JSFunctionWithPrototype
    generates 'JSFunction';
