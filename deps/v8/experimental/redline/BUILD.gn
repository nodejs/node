  sources = [
    "base/file_util.cc",
    "base/file_util.h",
    "base/flags.cc",
    "base/flags.h",
    "base/json.cc",
    "base/json.h",
    "base/json_parser.cc",
    "base/json_parser.h",
    "base/log.cc",
    "base/log.h",
    "base/subprocess.cc",
    "base/subprocess.h",
    "base/time_util.h",
    "base/v8_runtime.cc",
    "base/v8_runtime.h",
    "commands/amplify_command.cc",
    "commands/command.h",
    "commands/exec_command.cc",
    "commands/fuzz_command.cc",
    "commands/minimize_command.cc",
    "commands/mutate_command.cc",
    "commands/parse_command.cc",
    "commands/replay_command.cc",
    "commands/roundtrip_command.cc",
    "commands/selftest_checker.h",
    "commands/selftest_command.cc",
    "commands/selftest_selection.cc",
    "commands/selftest_selection.h",
    "commands/shell_command.cc",
    "core/adaptive_selector.h",
    "core/ast_builder.cc",
    "core/ast_builder.h",
    "core/builder.cc",
    "core/builder.h",
    "core/component.cc",
    "core/component.h",
    "core/environment.cc",
    "core/environment.h",
    "core/program.cc",
    "core/program.h",
    "core/random.h",
    "core/selection.cc",
    "core/selection.h",
    "core/tunable.cc",
    "core/tunable.h",
    "core/weighted_selector.h",
    "corpus/corpus.cc",
    "corpus/corpus.h",
    "engine/amplifier.cc",
    "engine/amplifier.h",
    "engine/config.cc",
    "engine/config.h",
    "engine/crash.cc",
    "engine/crash.h",
    "engine/fuzzer.cc",
    "engine/fuzzer.h",
    "engine/importer.cc",
    "engine/importer.h",
    "engine/prelude.cc",
    "engine/prelude.h",
    "engine/shared_coverage.cc",
    "engine/shared_coverage.h",
    "engine/stages.cc",
