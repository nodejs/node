import("../../gni/v8.gni")

# Redline is a coverage-guided JavaScript fuzzer for d8, written in C++ and
# living in the V8 tree. The fuzzer itself does not need coverage
# instrumentation: it drives a separately built, instrumented d8 (built with
# v8_fuzzilli=true and sanitizer_coverage_flags set) over the REPRL protocol
# that d8 already implements for Fuzzilli. See README.md.

# Stricter diagnostics for this directory only. The V8 headers that redline
# includes (include/, src/base/, ...) are treated as system headers so that
# only Redline's own code is held to these flags.
config("redline_warnings") {
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wconversion",
    "-Wshadow",
    "-Wunused",
    "-Werror",
  ]
  if (is_clang) {
    cflags += [
      "--system-header-prefix=include/",
      "--system-header-prefix=src/",
      "--system-header-prefix=third_party/",
      "--system-header-prefix=absl/",

      # The toolchain compiles with -MMD, which omits system headers from the
      # dependency file. Keep these headers in the dependency file.
      "-Xclang",
      "-sys-header-deps",
    ]
  }
  cflags_cc = [
    "-Wnon-virtual-dtor",
    "-Wold-style-cast",
    "-Woverloaded-virtual",
  ]
}

