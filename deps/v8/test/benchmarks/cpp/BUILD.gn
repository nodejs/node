import("../../../gni/v8.gni")

group("gn_all") {
  testonly = true

  deps = []

  if (v8_enable_google_benchmark) {
    deps += [
      ":bindings_benchmark",
      ":dtoa_benchmark",
      ":empty_benchmark",
      ":fast_api_benchmark",
      "cppgc:gn_all",
    ]
  }
}

if (v8_enable_google_benchmark) {
  if (build_with_chromium) {
    google_benchmark_dep = "//third_party/google_benchmark"
    benchmark_main_dep = "//third_party/google_benchmark:benchmark_main"
  } else {
    google_benchmark_dep =
        "//third_party/google_benchmark_chrome:google_benchmark"
    benchmark_main_dep = "//third_party/google_benchmark_chrome:benchmark_main"
  }

  v8_executable("empty_benchmark") {
    testonly = true

    configs = [ "../../..:internal_config_base" ]

    sources = [ "empty.cc" ]

    deps = [
      "../../..:v8_libbase",
      benchmark_main_dep,
      google_benchmark_dep,
    ]
  }

  v8_executable("dtoa_benchmark") {
    testonly = true

    configs = [ "../../..:internal_config_base" ]

    sources = [ "dtoa.cc" ]

    deps = [
      "../../..:v8_libbase",
      benchmark_main_dep,
      google_benchmark_dep,
    ]
  }

  v8_executable("bindings_benchmark") {
    testonly = true

    configs = [ "../../..:internal_config_base" ]

    sources = [
      "benchmark-main.cc",
      "benchmark-utils.cc",
      "benchmark-utils.h",
      "bindings.cc",
    ]

    deps = [
      "../../..:v8",
      "../../..:v8_internal_headers",
      "../../..:v8_libbase",
      "../../..:v8_tracing",
      google_benchmark_dep,
    ]
  }

  v8_executable("fast_api_benchmark") {
    testonly = true

    configs = [ "../../..:internal_config_base" ]

    sources = [
      "benchmark-main.cc",
      "benchmark-utils.cc",
      "benchmark-utils.h",
      "fast-api.cc",
    ]

    deps = [
      "../../..:v8",
      "../../..:v8_libbase",
      google_benchmark_dep,
    ]
  }
}
