[
##############################################################################
[ALWAYS, {
  # Issue 3660: Replacing activated TurboFan frames by unoptimized code does
  # not work, but we expect it to not crash.
  'debugger/debug-step-turbofan': [PASS, FAIL],

  # Issue 3641: The new 'then' semantics suppress some exceptions.
  # These tests may be changed or removed when 'chain' is deprecated.
  'debugger/es6/debug-promises/reject-with-throw-in-reject': [FAIL],
  'debugger/es6/debug-promises/reject-with-undefined-reject': [FAIL],
  'debugger/es6/debug-promises/reject-with-invalid-reject': [FAIL],

  # forcing weak callback in asan build change break order
  'debugger/debug-stepin-builtin-callback': [['asan == True or msan == True', SKIP]],

  # https://crbug.com/v8/7932
  'runtime/command-line-api-without-side-effects': [SKIP],

  # https://crbug.com/v8/13851
  'debugger/pause-on-oom': [SKIP],

  # Issue 5651: Context mismatch in ScopeIterator::Type() for eval default
  # parameter value (the test causes indexing a FixedArray out of bounds ->
  # CRASH is also a reasonable outcome).
  'debugger/es6/debug-scope-default-param-with-eval': [FAIL, CRASH],

  # Require optimization, so can't be run on Lite mode.
  'cpu-profiler/coverage-block': [PASS, ['lite_mode == True', SKIP]],
  'cpu-profiler/coverage': [PASS, ['lite_mode == True', SKIP]],

  # https://crbug.com/v8/9029
  'debugger/script-on-after-compile-snapshot': [SKIP],
  'debugger/debug-step-prefix-bytecodes': [PASS, HEAVY, ['mode == debug', SKIP]],

  # https://crbug.com/1080638
  # The initial CL only fixed the crash. The test still causes an endless
  # loop instead of properly reporting a RangeError for a stack overflow.
  'regress/regress-crbug-1080638': [SKIP],

  # Tests that need to run sequentially (e.g. due to memory consumption).
  'runtime/console-messages-limits': [PASS, SLOW, HEAVY],
  'debugger/debug-stepout-scope-part1': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part2': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part3': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part4': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part5': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part6': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part7': [PASS, HEAVY],
  'debugger/debug-stepout-scope-part8': [PASS, HEAVY],
  'runtime/regression-732717': [PASS, HEAVY],
  'debugger/debug-scopes': [PASS, HEAVY],

  # Use-after-free regression tests, only meaningful under ASan.
  'runtime/regress-520052954': [PASS, ['not asan', SKIP]],
  'runtime/regress-520052954-2': [PASS, ['not asan', SKIP]],
  'runtime/regress-520052954-3': [PASS, ['not asan', SKIP]],

  # Sandbox regression tests requiring the memory corruption API.
  'regress/regress-502337304': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-507490539': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-513048538': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-513360060': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-568338771': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-570558888': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-576575667': [PASS, ['not memory_corruption_api', SKIP]],
  'regress/regress-crbug-568986689': [PASS, ['not memory_corruption_api', SKIP]],
}],  # ALWAYS

