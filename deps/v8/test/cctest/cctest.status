}],  # 'clang_coverage and mode == debug'

##############################################################################
['sandbox_hardware_support', {
  # Tests that require the sampler/profiler, which doesn't work on older kernel
  # versions if hardware sandboxing is active. See https://crbug.com/429173713.
  'test-cpu-profiler/*': [SKIP],
  'test-profile-generator/*': [SKIP],
  'test-api/SimpleCallbackWithProfiler': [SKIP],
  'test-api/FastReturnValuesWithProfiler': [SKIP],
  'test-api/FunctionTemplateWithProfiler': [SKIP],
  'test-api/CallICFastApi_TrivialSignatureWithProfiler': [SKIP],
