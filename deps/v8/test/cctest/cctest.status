  'test-accessor-assembler/*': [SKIP],
  'test-code-stub-assembler/*': [SKIP],
  'test-debug-helper/GetObjectProperties': [SKIP],
  'test-run-intrinsics/*': [SKIP],
  'test-run-stackcheck/*': [SKIP],
  'test-run-unwinding-info/*': [SKIP],
  'test-run-variables/*': [SKIP],
