  'test-js-to-wasm/*': [SKIP],
}], # variant == jitless

################################################################################
['variant == stress_snapshot', {
  '*': [SKIP],  # only relevant for mjsunit tests.
}],

################################################################################
['variant == stress_concurrent_inlining', {
  # crbug.com/v8/11649: Improper access to BreakInfo and friends.
