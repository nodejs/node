  'LogAllTest.LogAll': [PASS, SLOW, HEAVY],
  'WasmModuleVerifyTest.NGlobals': [PASS, HEAVY],

  # BUG(13660): Flaky test.
  'OS.RemapPages': [SKIP],

  # Those smoke tests fail nondeterministically to test fuzzer infrastructure.
  # We cannot run them in unittest mode as they would produce flakes.
  'SmokeTest.*': [SKIP],

  ##############################################################################
  # Behavioural differences between Maglev and Turbofan when the former is used
  # for OptimizeFunctionOnNextCall.
  #
  # Maglev doesn't support compiler::NodeObserver machinery.
  'SloppyEqualityTest.SloppyEqualityTest': [SKIP],
   # RunDeoptTest checks frame->is_turbofan().
  'RunDeoptTest.DeoptSimple': [SKIP],
  'RunDeoptTest.DeoptSimpleInExpr': [SKIP],
}],  # ALWAYS

