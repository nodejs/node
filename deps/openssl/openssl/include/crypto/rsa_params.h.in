);

our @RSA_KEY_TYPES = (
    ['OSSL_PKEY_PARAM_RSA_N', 'n', 'BN'],
    ['OSSL_PKEY_PARAM_RSA_E', 'e', 'BN'],
    ['OSSL_PKEY_PARAM_RSA_D', 'd', 'BN'],
    @RSA_KEY_MP_TYPES
);

our @RSA_PSS_IMPORT_TYPES = (
    ['OSSL_PKEY_PARAM_RSA_DIGEST',       'digest',       'utf8_string'],
    ['OSSL_PKEY_PARAM_RSA_DIGEST_PROPS', 'digest_props', 'utf8_string'],
    ['OSSL_PKEY_PARAM_RSA_MASKGENFUNC',  'maskgenfunc',  'utf8_string'],
