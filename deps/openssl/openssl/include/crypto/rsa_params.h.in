#define rsa_pss_pkey_import_from_st rsa_params_st
{- produce_param_decoder('rsa_pss_pkey_import_from',
                         (@RSA_KEY_TYPES,
                          ['OSSL_PKEY_PARAM_RSA_DERIVE_FROM_PQ', 'derive', 'int'],
                          @RSA_PSS_IMPORT_TYPES
                         )); -}

