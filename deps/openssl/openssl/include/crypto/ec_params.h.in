                          @EC_KEY_TYPES, @EC_AFFINE_PUBLIC_KEY_TYPES)); -}

#define ec_set_params_st ec_params_st
{- produce_param_decoder('ec_set_params', @EC_SETTABLE_TYPES); -}

#define sm2_set_params_st ec_params_st
