struct fips_global_st;
static FIPS_PARAMS *get_fips_params(struct fips_global_st *fgbl);
int ossl_fips_config(OSSL_LIB_CTX *libctx, enum fips_config_id id)
{
    struct fips_global_st *fgbl = ossl_lib_ctx_get_data(libctx, OSSL_LIB_CTX_FIPS_PROV_INDEX);
    FIPS_PARAMS *params = get_fips_params(fgbl);
    switch (id) {
    case FIPS_CONFIG_SECURITY_CHECKS:
        return params->security_checks;
    case FIPS_CONFIG_TLS1_PRF_EMS_CHECK:
        return params->tls1_prf_ems_check;
    case FIPS_CONFIG_NO_SHORT_MAC:
        return params->no_short_mac;
    case FIPS_CONFIG_HMAC_KEY_CHECK:
        return params->hmac_key_check;
    case FIPS_CONFIG_KMAC_KEY_CHECK:
        return params->kmac_key_check;
    case FIPS_CONFIG_DRBG_TRUNC_DIGEST:
        return params->restricted_drbg_digests;
    case FIPS_CONFIG_SIGNATURE_DIGEST_CHECK:
        return params->signature_digest_check;
    case FIPS_CONFIG_HKDF_DIGEST_CHECK:
        return params->hkdf_digest_check;
    case FIPS_CONFIG_TLS13_KDF_DIGEST_CHECK:
        return params->tls13_kdf_digest_check;
    case FIPS_CONFIG_TLS1_PRF_DIGEST_CHECK:
        return params->tls1_prf_digest_check;
    case FIPS_CONFIG_SSHKDF_DIGEST_CHECK:
        return params->sshkdf_digest_check;
    case FIPS_CONFIG_SSKDF_DIGEST_CHECK:
        return params->sskdf_digest_check;
    case FIPS_CONFIG_X963KDF_DIGEST_CHECK:
        return params->x963kdf_digest_check;
    case FIPS_CONFIG_DSA_SIGN_DISABLED:
        return params->dsa_sign_disallowed;
    case FIPS_CONFIG_TDES_ENCRYPT_DISABLED:
        return params->tdes_encrypt_disallowed;
    case FIPS_CONFIG_RSA_PKCS15_PAD_DISABLED:
        return params->rsa_pkcs15_padding_disabled;
    case FIPS_CONFIG_RSA_PSS_SALTLEN_CHECK:
        return params->rsa_pss_saltlen_check;
    case FIPS_CONFIG_RSA_SIGN_X931_PAD_DISABLED:
        return params->rsa_sign_x931_disallowed;
    case FIPS_CONFIG_HKDF_KEY_CHECK:
        return params->hkdf_key_check;
    case FIPS_CONFIG_KBKDF_KEY_CHECK:
        return params->kbkdf_key_check;
    case FIPS_CONFIG_TLS13_KDF_KEY_CHECK:
        return params->tls13_kdf_key_check;
    case FIPS_CONFIG_TLS1_PRF_KEY_CHECK:
        return params->tls1_prf_key_check;
    case FIPS_CONFIG_SSHKDF_KEY_CHECK:
        return params->sshkdf_key_check;
    case FIPS_CONFIG_SSKDF_KEY_CHECK:
        return params->sskdf_key_check;
    case FIPS_CONFIG_X963KDF_KEY_CHECK:
        return params->x963kdf_key_check;
    case FIPS_CONFIG_X942KDF_KEY_CHECK:
        return params->x942kdf_key_check;
    case FIPS_CONFIG_PBKDF2_LOWER_BOUND_CHECK:
        return params->pbkdf2_lower_bound_check;
    case FIPS_CONFIG_ECDH_COFACTOR_CHECK:
        return params->ecdh_cofactor_check;
    default:
        return -1;
    }
}

