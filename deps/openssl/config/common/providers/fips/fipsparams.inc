static int return_fips_params(OSSL_PARAM *params, FIPS_PARAMS *fp)
{
    OSSL_PARAM *p = params;

    for (;p->key != NULL; p++) {
        if (strcmp(OSSL_PROV_PARAM_SECURITY_CHECKS, p->key) == 0)
            if (!OSSL_PARAM_set_int(p, fp->security_checks))
               return 0;
        if (strcmp(OSSL_PROV_PARAM_TLS1_PRF_EMS_CHECK, p->key) == 0)
            if (!OSSL_PARAM_set_int(p, fp->tls1_prf_ems_check))
               return 0;
