                if (pbkdf2_lower_bound_check != NULL
                    && strcmp(pbkdf2_lower_bound_check, "1") == 0)
                    fp->pbkdf2_lower_bound_check = 1;
                else if (pbkdf2_lower_bound_check != NULL
                    && strcmp(pbkdf2_lower_bound_check, "0") == 0)
                    fp->pbkdf2_lower_bound_check = 0;
                else
                    return 0;
            }
            if (strcmp(OSSL_PROV_PARAM_ECDH_COFACTOR_CHECK, p->key) == 0) {
                if (ecdh_cofactor_check != NULL
                    && strcmp(ecdh_cofactor_check, "1") == 0)
                    fp->ecdh_cofactor_check = 1;
                else if (ecdh_cofactor_check != NULL
                    && strcmp(ecdh_cofactor_check, "0") == 0)
                    fp->ecdh_cofactor_check = 0;
                else
                    return 0;
            }
            if (strcmp(OSSL_PROV_PARAM_CORE_MODULE_FILENAME, p->key) == 0) {
                fp->module_filename = module_filename;
            }
            if (strcmp(OSSL_PROV_FIPS_PARAM_MODULE_MAC, p->key) == 0) {
                fp->module_checksum_data = module_checksum_data;
            }
            if (strcmp(OSSL_PROV_FIPS_PARAM_CONDITIONAL_ERRORS, p->key) == 0) {
                if (conditional_error_check != NULL
                    && strcmp(conditional_error_check, "1") == 0)
                    fp->conditional_error_check = 1;
                else if (conditional_error_check != NULL
                    && strcmp(conditional_error_check, "0") == 0)
                    fp->conditional_error_check = 0;
                else
                    return 0;
            }
            if (strcmp(OSSL_PROV_FIPS_PARAM_DEFER_TESTS, p->key) == 0) {
                if (defer_tests != NULL
                    && strcmp(defer_tests, "1") == 0)
                    fp->defer_tests = 1;
                else if (defer_tests != NULL
                    && strcmp(defer_tests, "0") == 0)
                    fp->defer_tests = 0;
                else
                    return 0;
            }
        }
    }
    return 1;
}

