{
  'targets': [
    {
      # The prefix header includes a header generated by the target's action.
      'target_name': 'pch_action',
      'type': 'static_library',
      'sources': [ 'pch.cc', 'pch_asm.S' ],
      'include_dirs': [ '<(SHARED_INTERMEDIATE_DIR)' ],
      'xcode_settings': {
        'GCC_PREFIX_HEADER': 'pch_action.h',
        'GCC_PRECOMPILE_PREFIX_HEADER': 'YES',
      },
      'actions': [
        {
          'action_name': 'generate_action_header',
          'inputs': [],
          'outputs': [ '<(SHARED_INTERMEDIATE_DIR)/action_generated.h' ],
          'action': [ 'touch', '<@(_outputs)' ],
        },
      ],
    },
    {
      # The prefix header includes a header generated by a dependency.
      'target_name': 'pch_dep',
      'type': 'static_library',
      'dependencies': [ 'generate_dep_header' ],
      'sources': [ 'pch.cc', 'pch_asm.S' ],
      'include_dirs': [ '<(SHARED_INTERMEDIATE_DIR)' ],
      'xcode_settings': {
        'GCC_PREFIX_HEADER': 'pch_dep.h',
        'GCC_PRECOMPILE_PREFIX_HEADER': 'YES',
      },
    },
    {
      'target_name': 'generate_dep_header',
      'type': 'none',
      'actions': [
        {
          'action_name': 'generate_dep_header',
          'inputs': [],
          'outputs': [ '<(SHARED_INTERMEDIATE_DIR)/dep_generated.h' ],
          'action': [ 'touch', '<@(_outputs)' ],
        },
      ],
    },
  ],
}
